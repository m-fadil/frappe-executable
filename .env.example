# Copy to .env, fill in, then pass it to any command:
#   frappe restore .env
#   frappe restore --env-file .env
# Anything here can also be set inline, which always wins over the file:
#   frappe restore .env -e RESTORE_SITE=other.localhost
#
# Every value below is a default unless marked REQUIRED.
#
# This file is sourced by bash: quote any value containing a space.


# === shared ===
# Used by more than one command, so it lives here once.

# Database root credentials. bench-init.sh uses them to create the site,
# restore.sh to drop and reload it.
DB_ROOT_USER=root
DB_ROOT_PASS=                          # REQUIRED by bench-init.sh and restore.sh


# === bench-init.sh ===
# Creates a fresh bench + site. The only command that does NOT need to run
# inside an existing bench — it creates one in the current directory.

MODE=docker                            # REQUIRED: server | docker
                                       #   docker -> bench init --skip-redis-config-generation,
                                       #             writes redis_* global config,
                                       #             new-site --mariadb-user-host-login-scope=%
                                       #   server -> none of the above, bench manages redis itself
# YES=1                                # skip the TUI and run straight away
FRAPPE_VERSION=version-16
BENCH_NAME=frappe-bench
SITE_NAME=development.localhost
# DB_NAME=                             # default: SITE_NAME with non-alphanumerics as _
DB_HOST=mariadb                        # server mode default: 127.0.0.1
DB_PORT=3306
ADMIN_PASS=                            # REQUIRED
# docker mode only, ignored in server mode:
REDIS_CACHE=redis://redis-cache:6379
REDIS_QUEUE=redis://redis-queue:6379
REDIS_SOCKETIO=redis://redis-socketio:6379
# BENCH_INIT_EXTRA=--verbose           # appended to 'bench init'
# BENCH_NEW_SITE_EXTRA="--install-app erpnext"


# === restore.sh ===
# Downloads the latest DB backup from a source site and restores it here.

RESTORE_SITE=                          # REQUIRED: target site in this bench
RESTORE_SOURCE_URL=https://source.example.com   # REQUIRED
RESTORE_SOURCE_TOKEN="token abcdef123456:secret789"   # REQUIRED: full Authorization header value
RESTORE_ADMIN_PASSWORD=                # REQUIRED: admin password set after restore
# RESTORE_DOWNLOAD_DIR=                # default: current directory
# RESTORE_SITES_DIR=sites
# RESTORE_CONNECTIONS=4                # aria2c -x / -s
# RESTORE_KEEP_BACKUP=1                # 0 = delete the archive once restored
# RESTORE_SKIP_MIGRATE=                # non-empty = skip 'bench migrate'


# === sanitize.sh ===
# Kills every outbound integration on a restored site. Run it before anyone
# touches the copy, or your clone will email real customers.

# SANITIZE_SITE=                       # default: RESTORE_SITE
# SANITIZE_SINGLES="FCM Settings,TP Twilio Settings,TP Exotel Settings"
                                       # single doctypes whose 'enabled' field is forced to 0
                                       # set empty to skip this step
# SANITIZE_SITES_DIR=sites
# SANITIZE_MUTE_EMAILS=1               # site_config mute_emails value


# === create-user.sh ===
# Creates a user and, by default, prints api_key:api_secret on the last line.

# USER_SITE=                           # default: the only site, else you are asked
USER_EMAIL=                            # REQUIRED (asked when running on a tty)
# USER_FIRST_NAME=                     # default: the part of USER_EMAIL before @
# USER_LAST_NAME=
USER_ROLES="System Manager"            # comma-separated; empty for no extra roles
# USER_PASSWORD=                       # set only when non-empty
USER_API_KEY=1                         # 0 = do not generate/print API credentials
# USER_WELCOME_EMAIL=0
# USER_SITES_DIR=sites


# === restore-sanitize.sh ===
# No variables of its own — it forwards every option to restore.sh then
# sanitize.sh, so the two sections above are what it reads.
