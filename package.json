{
  "name": "frappe-executable",
  "version": "1.0.0",
  "description": "CLI for Frappe bench chores: init a bench, restore + sanitize production clones, mint API users",
  "license": "MIT",
  "type": "module",
  "repository": "github:m-fadil/frappe-executable",
  "bin": {
    "frappe": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    ".env.example"
  ],
  "engines": {
    "node": "^20.17.0 || ^22.13.0 || >=23.5.0"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test dist/test/*.test.js",
    "prepack": "tsc -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
